   "source": [
    "Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "938fdd54",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "A =np.array([\n",
    "    [1,2],\n",
    "    [3,4]\n",
    "])\n",
    "B = np.array([\n",
    "    [5,6]\n",
    "    [7,8]\n",
    "])\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4416818b",
   "metadata": {},
   "outputs": [],
   "source": [
    "A@B  # Dot product \n",
    "\n",
    "\n",
    "# [[1*5 + 2*7, 1*6 + 2*8],\n",
    "#  [3*5 + 4*7, 3*6 + 4*8]]  "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "440bc46a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Transpose matrix:\n",
    "\n",
    "# row changes to colum \n",
    "\n",
    "A.T\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7e9c38f4",
   "metadata": {},
